{
  "name": "sremote-monorepo",
  "version": "3.0.0",
  "description": "SRemote - Allow a parent page to control media inside an iframe with permission",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "vite",
    "dev:wrapper": "npm run dev --workspace=packages/wrapper",
    "dev:ready2use": "npm run dev --workspace=packages/ready2use",
    "dev:userscript": "vite build --watch",
    "dev:all": "node scripts/watch-all.js",
    "build:watch": "node scripts/watch-all.js",
    "build:userscript": "npm run build:unmin && npm run build:min",
    "build:wrapper": "npm run build --workspace=packages/wrapper",
    "build:ready2use": "npm run build --workspace=packages/ready2use",
    "build:unmin": "vite build",
    "build:min": "cross-env MINIFY=true vite build",
    "build": "npm run build:userscript && npm run build:wrapper && npm run build:ready2use",
    "pack": "node scripts/pack.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "biome format --write .",
    "check:docs": "node scripts/check-api-docs.js",
    "knip": "knip"
  },
  "keywords": ["userscript", "iframe", "media-controller", "sremote"],
  "author": "sweetsea",
  "license": "LGPL-3.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "clean-css": "^5.3.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "knip": "^6.32.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-monkey": "^8.1.0"
  },
  "allowScripts": { "core-js@2.6.12": true }
}
