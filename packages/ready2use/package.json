{
  "name": "@sremote/ready2use",
  "version": "4.0.0-alpha.1",
  "description": "Ready-to-use out-of-the-box providers and adapters for SRemote",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./dist/index.mjs", "default": "./dist/index.mjs" },
    "./providers/*": "./src/providers/*.js",
    "./core/*": "./src/core/*.js",
    "./youtube": "./src/providers/youtube.js",
    "./vimeo": "./src/providers/vimeo.js",
    "./soundcloud": "./src/providers/soundcloud.js",
    "./dailymotion": "./src/providers/dailymotion.js",
    "./twitch": "./src/providers/twitch.js",
    "./mixcloud": "./src/providers/mixcloud.js",
    "./spotify": "./src/providers/spotify.js",
    "./tiktok": "./src/providers/tiktok.js",
    "./niconico": "./src/providers/niconico.js",
    "./bilibili": "./src/providers/bilibili.js",
    "./facebook": "./src/providers/facebook.js",
    "./twitter": "./src/providers/twitter.js",
    "./peertube": "./src/providers/peertube.js",
    "./rumble": "./src/providers/rumble.js",
    "./kick": "./src/providers/kick.js",
    "./streamable": "./src/providers/streamable.js",
    "./odysee": "./src/providers/odysee.js",
    "./bandcamp": "./src/providers/bandcamp.js",
    "./instagram": "./src/providers/instagram.js",
    "./threads": "./src/providers/threads.js",
    "./applemusic": "./src/providers/applemusic.js",
    "./musickit": "./src/providers/musickit.js"
  },
  "files": ["dist", "src", "README.md"],
  "publishConfig": { "access": "public" },
  "scripts": { "build": "vite build", "dev": "vite build --watch", "test": "node test/providers.test.js" },
  "keywords": ["sremote", "youtube", "vimeo", "html5", "adapter", "ready-to-use", "player", "preset"],
  "author": "sweetsea (https://github.com/SweetSea-ButImNotSweet)",
  "repository": { "type": "git", "url": "git+https://github.com/SweetSea-ButImNotSweet/sremote.git", "directory": "packages/ready2use" },
  "homepage": "https://github.com/SweetSea-ButImNotSweet/sremote#readme",
  "bugs": { "url": "https://github.com/SweetSea-ButImNotSweet/sremote/issues" },
  "license": "LGPL-3.0",
  "peerDependencies": { "@sremote/sdk": ">=3.0.0" },
  "devDependencies": { "@sremote/sdk": "^3.0.0", "@sremote/shared": "*" }
}
